# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# PostgreSQL (docker-compose defaults)
DATABASE_URL=postgresql://movievault:movievault@localhost:5432/movievault

# TMDB (get a free key at https://www.themoviedb.org/settings/api)
TMDB_API_KEY=
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p

# Auth
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_EMAIL=admin@movievault.local
ADMIN_PASSWORD=admin123

# Metadata provider (tmdb | simkl)
METADATA_PROVIDER=tmdb
SIMKL_CLIENT_ID=
SIMKL_CLIENT_SECRET=
SIMKL_ACCESS_TOKEN=
SIMKL_REFRESH_TOKEN=
